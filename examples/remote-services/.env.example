# Copy to .env on the SERVER, then: chmod 600 .env
# Never commit the real .env.

# Private-network IP of this server (Tailscale, WireGuard, LAN). NOT a public IP.
BIND_IP=<PRIVATE_NETWORK_IP>

# Generate long random values, e.g.: openssl rand -hex 24
TEMPORAL_DB_PASSWORD=<change-me>
NEO4J_PASSWORD=<change-me>

# Optional, only if you enable QDRANT__SERVICE__API_KEY in docker-compose.yml
# QDRANT_API_KEY=<change-me>
